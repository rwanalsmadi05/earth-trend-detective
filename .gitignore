# secrets: never commit (the example file is the only .env that is tracked)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
frontend/.env.local
frontend/.env.*.local

# node
node_modules/
frontend/dist/
*.tsbuildinfo

# python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
*.egg-info/

# logs, OS and editor noise
*.log
.DS_Store
Thumbs.db

